@startuml labukdb-v2-module-architecture
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam roundCorner 10
skinparam shadowing false

skinparam rectangle {
  BorderColor #888780
  BackgroundColor #F1EFE8
  FontColor #2C2C2A
}
' reused today, unchanged behavior
skinparam component {
  BorderColor #534AB7
  BackgroundColor #EEEDFE
  FontColor #26215C
}
skinparam database {
  BorderColor #0F6E56
  BackgroundColor #E1F5EE
  FontColor #04342C
}
skinparam actor {
  BorderColor #993C1D
  BackgroundColor #FAECE7
  FontColor #4A1B0C
}
skinparam note {
  BorderColor #888780
  BackgroundColor #F1EFE8
  FontColor #2C2C2A
}

title labukDB v2 — Multi-Module Architecture (planned)\nCopyright 2026 Afzal and lakehouse-flight contributors — Apache 2.0

legend top left
  |= color |= meaning |
  |<#EEEDFE>| reused from delta-flight-engine v1, package renamed com.labuk.deltaflight → com.labuk.labukdb |
  |<#D9F2C4>| new in v2 — built and verified |
  |<#FFF1CF>| new in v2 — still planned, does not exist yet |
endlegend

' ─── EXTERNAL WRITERS ───────────────────────────────────
package "External writers (unchanged role)" #F1EFE8 {
  [Spark batch]       as SB  #D3D1C7
  [Spark streaming]   as SS  #D3D1C7
  [Flink]             as FL  #D3D1C7
  [Other Iceberg\nwriter (Trino, etc.)] as OIW #D3D1C7
}

' ─── STORAGE ─────────────────────────────────────────────
database "Delta table" as DT #9FE1CB {
  [_delta_log/\n(JSON commits + checkpoints)] as LOG
  [Parquet data files] as PAR
}

database "Iceberg table" as IT #9FE1CB {
  [metadata/\n(manifest lists + manifest files)] as ICEMETA
  [Parquet data files] as ICEPAR
}

note bottom of DT
  Backends: local disk · MinIO (s3a://)
  S3 (s3a://) · ADLS Gen2 (abfss://)
end note

SB  --> DT : commits add/remove actions
SS  --> DT : one commit per micro-batch
FL  --> DT : commits add/remove actions
OIW --> IT : Iceberg commit protocol

' ─── labukdb-core ────────────────────────────────────────
package "labukdb-core  (embeddable library — no Flight/gRPC dependency, DuckDB-style)" #EEEDFE {

  package "storage/ — location dispatch (reused)" #EEEDFE {
    [TableLocation] as TL
    [MinioConfiguration] as MC
    [AdlsConfiguration]  as AC
  }

  package "format/ — TableFormat SPI (built, additive-only --\nnot yet wired into planner/flight/cli)" #D9F2C4 {
    [TableFormat\n(interface: snapshot → schema +\npartitionSpec + List<DataFileRef>)] as TF #D9F2C4
    [DeltaTableFormat\n(wraps log/ below)] as DTF #D9F2C4
  }

  package "log/ — commit log + write path (reused + new in v2)" #EEEDFE {
    [CommitLogReader] as CLR
    [CheckpointReader\n(single + multi-part)] as CPR
    [SnapshotManager\n(latest/atVersion/atTimestamp)] as SM
    [TableCache] as TC
    [LocalNioLogStorage] as LNS
    [HadoopLogStorage\n(S3/MinIO/ADLS)] as HLS
    [WriteBuffer\n(in-memory per-table buffer,\nWAL-backed, flush on\nsize/time threshold)] as WB #D9F2C4
    [CommitWriter\n(atomic commit, multi-writer OCC\non local disk — see note)] as CW #D9F2C4
    [Compactor\n(bin-pack small files,\nOPTIMIZE-style commit,\ndataChange=false)] as COMP #D9F2C4
    [Vacuum\n(remove orphaned files\npast retention window)] as VAC #D9F2C4
    [TableMerger\n(upsert/MERGE by key —\nthe foundation a CDC source\nlike Debezium needs,\ndataChange=true)] as TMRG #D9F2C4

    note right of CW
      Atomic create-if-absent commit,
      per storage backend:
      · local disk — trivial (CREATE_NEW)
      · MinIO — verified against a
        real cluster (quay.io/minio/minio)
      · S3 (native AWS) — implemented,
        not yet verified against a
        real AWS endpoint
      · ADLS Gen2 — implemented,
        not yet verified against a
        real ADLS endpoint
      Multi-writer OCC done for local
      disk (appendBatch retries
      unconditionally; replaceFiles/
      TableMerger re-check their file
      set on every attempt). Remote
      OCC not started — CommitWriter
      itself is still local-disk only.
    end note
  }

  package "planner/ — pruning (reused, format-agnostic)" #EEEDFE {
    [PartitionPruner] as PP
    [FileStatsPruner] as FSP
    [QueryPlanner] as QP
    [PartitionValueSubstituter] as PVS
    [PredicateColumns] as PC
  }

  package "decode/ — Parquet → Arrow (reused)" #EEEDFE {
    [ParquetToArrowReader] as PTAR
    [RowGroupPruner] as RGP
    [GroupPredicateEvaluator] as GPE
    [PartitionValueAppender] as PVA
    [NestedTypeDecoder] as NTD
    [Int96TimestampCodec] as ITC
    [ParquetFooterCache] as PFC
  }

  package "encode/ — Arrow → Parquet" #D9F2C4 {
    [ArrowToParquetWriter\n(mirror of ParquetToArrowReader)] as ATPW #D9F2C4
  }

  package "execution/ — query operators (wired into flight/ and cli/)" #D9F2C4 {
    [AggregateOperator\n(GROUP BY, SUM/COUNT/\nMIN/MAX/AVG)] as AOP #D9F2C4
    [SortLimitOperator\n(ORDER BY ... LIMIT)] as SOP #D9F2C4
    [CombinedQueryExecutor\n(decode every surviving file,\ncombine, optionally aggregate,\noptionally sort+limit -- the one\nreal implementation flight/ and\ncli/ both call, not two copies\nthat could drift)] as CQE #D9F2C4
  }

  note bottom of AOP
    No FilterOperator — deliberately
    not built. decode/'s existing fused
    residual-predicate pass already
    covers this; a separate post-decode
    operator would have no real caller.
  end note

  package "query/ — SQL text → engine structures" #D9F2C4 {
    [SqlQueryTranslator\n(SELECT/WHERE/GROUP BY/\nORDER BY/LIMIT via jsqlparser --\na real SQL grammar isn't one of\nthis project's own from-scratch\nlearning goals, unlike Delta/\nParquet/pruning/execution)] as SQTR #D9F2C4
    [SqlQuery\n(record: table, columns,\npredicate, groupBy,\naggregates, orderBy, limit)] as SQQ #D9F2C4
  }

  note bottom of SQTR
    IN combined with AND/OR requires
    explicit parens -- a real jsqlparser
    grammar quirk (bare IN(...) greedily
    consumes a trailing OR/AND) rejected
    with a specific error, not silently
    misparsed. COUNT(*) rejected too,
    matching AggregateOperator's existing
    COUNT(column)-only semantics.
  end note

  package "catalog/ — name → location (reused)" #EEEDFE {
    [TableCatalog\n(name → location + format,\n~/.labukdb/catalog.json)] as CAT
  }
}

' ─── optional format module ──────────────────────────────
package "labukdb-format-iceberg  (optional — pulls in iceberg-core)" #D9F2C4 {
  [IcebergTableFormat\n(implements TableFormat,\ndelegates manifest parsing\nto iceberg-core — READ-ONLY,\nno Iceberg write support yet)] as ITF #D9F2C4
}

' ─── labukdb-flight ───────────────────────────────────────
package "labukdb-flight  (depends on core [+ format-iceberg])" #EEEDFE {
  [DeltaFlightProducer\nGetFlightInfo · DoGet · DoPut\nGetSchema · ListFlights\n(local + remote s3a://abfss://\nreads AND writes live-MinIO-\nverified; combine-mode DoGet for\nGROUP BY/ORDER BY/LIMIT, single\nendpoint across all surviving files)] as DFP
  [TicketRegistry] as TR
}

package "labukdb-server-app" #EEEDFE {
  [LabukDbServerApp\n(bootstrap main, shaded jar)] as DFSA
}

package "labukdb-cli  (depends on core in-process, no server)" #EEEDFE {
  [LabukDbCli\ncatalog / describe / query\n(--table/--filter or real --sql;\nno ingest/compact/vacuum yet)] as CLI
  [TableResolver] as TR2
}

' ─── LAYER WIRING ────────────────────────────────────────
DT --> CLR : JSON-lines commit files
DT --> CPR : .checkpoint.parquet
IT --> ICEMETA

CLR --> SM
CPR --> SM
SM  --> TC
TC  --> LNS : local path
TC  --> HLS : s3a:// / abfss://
LNS --> LOG
HLS --> LOG

DTF  --> SM  : read path (unchanged)
CW   --> DT  : atomic commit (add/remove actions)
COMP --> CW  : rewrite + commit bin-packed files\n(dataChange=false)
TMRG --> PTAR : decode existing partition files
TMRG --> CW  : insert/update/delete by key,\ncommit via replaceFiles\n(dataChange=true)
VAC  --> DT  : delete files past retired-and-expired

ITF --> IT : read via iceberg-core
TF  <|.. DTF
TF  <|.. ITF

QP  --> PP
QP  --> FSP
QP  --> PVS
QP  --> PC
TF  .[#993C1D].> QP : NOT wired yet -- two real shape\nmismatches surfaced (atVersion's\nsequential-version assumption vs.\nIceberg's snapshotId; schemaString's\nDelta-JSON shape vs. Iceberg's typed Schema)

PTAR --> RGP
PTAR --> GPE
PTAR --> PVA
PTAR --> NTD
PTAR --> ITC
PTAR --> PFC
AOP  --> PTAR : consumes already-decoded,\nalready-filtered Arrow batches\n(decode/'s own fused residual filter,\nno separate FilterOperator)
SOP  --> AOP

CQE --> PTAR : decode every surviving file
CQE --> AOP  : optional GROUP BY
CQE --> SOP  : optional ORDER BY / LIMIT

SQTR --> SQQ : parse() returns

WB   --> ATPW : flush threshold hit\n(size or time)
ATPW --> CW : new Parquet file path\nfor a committed add action
WB ..> PTAR : read-your-writes\n(not-yet-flushed rows,\nchecked alongside committed files)

TL --> MC
TL --> AC

DFP --> QP
DFP --> CQE  : combine-mode DoGet --\ngroupBy/aggregates/orderBy/limit\npresent, one combined endpoint\ninstead of one-per-file
DFP --> WB   : DoPut → buffer first
DFP --> TR
DFP --> CAT
DFSA --> DFP

CLI --> TR2
TR2 --> CAT
TR2 --> TL
CLI --> QP   : direct in-process query\n(catalog / describe / query only --\nno ingest/compact/vacuum subcommand yet)
CLI --> SQTR : --sql "<SELECT ...>"\n(mutually exclusive with\n--table/--columns/--filter/--limit)
CLI --> CQE  : combine-mode SQL --\nGROUP BY/ORDER BY/LIMIT present\n(same trigger DFP uses, so flight/\nand cli/ behave identically)

' ─── CLIENTS ─────────────────────────────────────────────
actor "Python\n(pyarrow.flight)" as PY  #FAECE7
actor "Java\n(arrow-flight-core)" as JV  #FAECE7
actor "Go / Rust / JS\n(any Flight client)" as GX #FAECE7
actor "RAG / LLM\n(MCP tool)" as RAG #FAECE7

PY  --> DFSA : GetFlightInfo · DoGet · DoPut
JV  --> DFSA
GX  --> DFSA
RAG --> DFSA

@enduml
