<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.labuk</groupId>
  <artifactId>labukdb-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <!--
    labukDB — multi-module lakehouse database (reads/writes Delta tables,
    reads Iceberg tables, embeddable or Flight-served). This is phase 1 of
    the v2 plan: pure module/package restructuring, no new behavior.
    See docs/labukdb-v2-architecture.md for the full target design.

    Module dependency order:
      labukdb-core         — the embeddable engine, no Flight/gRPC dependency
      labukdb-flight        — depends on core, adds Arrow Flight serving
      labukdb-server-app    — depends on core + flight, bootstraps + shades a runnable server jar
      labukdb-cli           — depends on core only (in-process, no server needed), shades a runnable CLI jar
  -->
  <modules>
    <module>labukdb-core</module>
    <module>labukdb-format-iceberg</module>
    <module>labukdb-flight</module>
    <module>labukdb-server-app</module>
    <module>labukdb-cli</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jackson.version>2.17.1</jackson.version>
    <junit.version>5.10.2</junit.version>
    <parquet.version>1.13.1</parquet.version>
    <arrow.version>16.1.0</arrow.version>
    <hadoop.version>3.4.3</hadoop.version>
    <iceberg.version>1.12.0</iceberg.version>
    <surefire.version>3.2.5</surefire.version>
    <shade.version>3.5.1</shade.version>
  </properties>

  <!--
    Centralized so every module declares a dependency without repeating a
    version. Per-module comments explaining *why* each dependency is
    needed live in that module's own pom.xml, close to the code that uses
    it, rather than here.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.labuk</groupId>
        <artifactId>labukdb-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.labuk</groupId>
        <artifactId>labukdb-flight</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>

      <dependency>
        <groupId>org.apache.iceberg</groupId>
        <artifactId>iceberg-core</artifactId>
        <version>${iceberg.version}</version>
      </dependency>

      <dependency>
        <groupId>org.apache.parquet</groupId>
        <artifactId>parquet-column</artifactId>
        <version>${parquet.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.parquet</groupId>
        <artifactId>parquet-hadoop</artifactId>
        <version>${parquet.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.parquet</groupId>
        <artifactId>parquet-common</artifactId>
        <version>${parquet.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.hadoop</groupId>
        <artifactId>hadoop-client</artifactId>
        <version>${hadoop.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.hadoop</groupId>
        <artifactId>hadoop-aws</artifactId>
        <version>${hadoop.version}</version>
        <optional>true</optional>
      </dependency>
      <dependency>
        <groupId>org.apache.hadoop</groupId>
        <artifactId>hadoop-azure</artifactId>
        <version>${hadoop.version}</version>
        <optional>true</optional>
      </dependency>

      <dependency>
        <groupId>org.apache.arrow</groupId>
        <artifactId>arrow-vector</artifactId>
        <version>${arrow.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.arrow</groupId>
        <artifactId>arrow-memory-netty</artifactId>
        <version>${arrow.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.arrow</groupId>
        <artifactId>arrow-algorithm</artifactId>
        <version>${arrow.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.arrow</groupId>
        <artifactId>flight-core</artifactId>
        <version>${arrow.version}</version>
      </dependency>

      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
          <configuration>
            <!--
              Arrow's memory library reaches into java.nio.Buffer reflectively
              for off-heap access, which the JPMS module system blocks by
              default on Java 9+. This is Arrow's own documented requirement
              (https://arrow.apache.org/docs/java/install.html), not specific
              to this project — every Arrow-Java consumer needs it. Wiring it
              in here means `mvn test` just works for every module that runs
              Arrow-touching tests, without each one repeating the flag.
            -->
            <argLine>--add-opens=java.base/java.nio=org.apache.arrow.memory.core,ALL-UNNAMED</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${shade.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
