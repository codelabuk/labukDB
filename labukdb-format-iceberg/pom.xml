<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.labuk</groupId>
    <artifactId>labukdb-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>labukdb-format-iceberg</artifactId>
  <packaging>jar</packaging>

  <!--
    IcebergTableFormat — the second TableFormat implementation (see
    labukdb-core's format/TableFormat), validating that interface's shape
    against a real second format instead of just DeltaTableFormat.
    Optional module: a Delta-only consumer of labukdb-core never needs to
    pull in iceberg-core's dependency tree.

    iceberg-core does NOT declare a hard dependency on Hadoop in its own
    POM (confirmed by inspecting it directly) — it works here because
    labukdb-core already brings hadoop-client onto the classpath for
    HadoopTables' org.apache.hadoop.conf.Configuration usage.
  -->
  <dependencies>
    <dependency>
      <groupId>com.labuk</groupId>
      <artifactId>labukdb-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Compile-scope now, optional (matching labukdb-core's own pattern
      for this exact dependency), not test-scope only anymore.
      DynamoDbLockManager (main source) directly references
      software.amazon.awssdk.services.dynamodb classes, transitively
      bundled via hadoop-aws's own software.amazon.awssdk:bundle
      dependency (confirmed zero new Maven dependency needed, same as
      labukdb-core's DynamoDbLockProvider). optional=true still means
      a plain library consumer of labukdb-format-iceberg isn't forced
      into the AWS SDK unless they also need S3A/DynamoDB, same
      reasoning labukdb-core already applies to this identical
      dependency. IcebergRemoteMinioIntegrationTest's own need for
      S3AFileSystem on the test classpath is satisfied the same way.
    -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-aws</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
