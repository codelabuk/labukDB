<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.labuk</groupId>
    <artifactId>labukdb-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>labukdb-server-app</artifactId>
  <packaging>jar</packaging>

  <!--
    Thin bootstrap: LabukDbServerApp wires labukdb-core + labukdb-flight
    into a runnable Flight server and shades everything into one jar, so
    `java -jar labukdb-server-app.jar` works directly instead of needing
    a hand-built classpath string — the same convenience labukdb-cli
    already had, now extended to the server.

    hadoop-aws/hadoop-azure are `optional` in labukdb-core's own pom
    (deliberately, so an embedding consumer who never touches remote
    storage doesn't get either cloud SDK forced on them) — but this is
    the actual runnable server binary README advertises as able to serve
    s3a:// / abfss:// tables over Flight, so it must pull them in for
    real. Without this override, `optional=true` propagates from the
    parent's dependencyManagement and the shaded jar silently ships with
    zero S3A/ADLS classes — verified: it did, before this was added.
  -->
  <dependencies>
    <dependency>
      <groupId>com.labuk</groupId>
      <artifactId>labukdb-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.labuk</groupId>
      <artifactId>labukdb-flight</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-aws</artifactId>
      <optional>false</optional>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-azure</artifactId>
      <optional>false</optional>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <!--
                ServicesResourceTransformer is not optional here — Hadoop's
                FileSystem lookup relies on merged META-INF/services entries
                across multiple jars; without it, shading silently keeps
                only one jar's service file and HadoopInputFile lookups
                break in the fat jar specifically, not on the unshaded
                classpath. Same requirement labukdb-cli has, for the same
                reason.
              -->
              <finalName>labukdb-server-app</finalName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.labuk.labukdb.serverapp.LabukDbServerApp</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
